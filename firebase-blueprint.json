{
  "entities": {
    "UserSettings": {
      "title": "UserSettings",
      "description": "User preferences, theme choice, active account filter, and allowed payment methods",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "theme": {
          "type": "string",
          "enum": ["light", "dark"]
        },
        "selectedAccountId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "paymentMethods": {
          "type": "array",
          "description": "List of configured payment method names (1 to 30 items)"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "theme", "selectedAccountId", "paymentMethods", "updatedAt"]
    },
    "Account": {
      "title": "Account",
      "description": "A personal bank or savings account",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "initialBalance": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerId", "name", "initialBalance", "createdAt", "updatedAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "A financial transaction (income or expense) belonging to an account",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "date": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "accountId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "type": {
          "type": "string",
          "enum": ["income", "expense"]
        },
        "amount": {
          "type": "number"
        },
        "paymentMethod": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "checkNumber": {
          "type": "string",
          "maxLength": 40
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "subcategory": {
          "type": "string",
          "maxLength": 100
        },
        "payee": {
          "type": "string",
          "maxLength": 120
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "cleared": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "date",
        "accountId",
        "type",
        "amount",
        "paymentMethod",
        "checkNumber",
        "category",
        "subcategory",
        "payee",
        "label",
        "cleared",
        "createdAt",
        "updatedAt"
      ]
    },
    "Category": {
      "title": "Category",
      "description": "Budget category with optional monthly limit and subcategories",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "budget": {
          "type": "number"
        },
        "subcategories": {
          "type": "array",
          "description": "Bounded list of subcategory names (max 50)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerId", "name", "budget", "subcategories", "createdAt", "updatedAt"]
    },
    "Payee": {
      "title": "Payee",
      "description": "Recurring payee/merchant with optional default category",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "defaultCategory": {
          "type": "string",
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerId", "name", "defaultCategory", "createdAt", "updatedAt"]
    },
    "Schedule": {
      "title": "Schedule",
      "description": "Monthly recurring transaction schedule",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "day": {
          "type": "integer"
        },
        "accountId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "type": {
          "type": "string",
          "enum": ["income", "expense"]
        },
        "amount": {
          "type": "number"
        },
        "paymentMethod": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "checkNumber": {
          "type": "string",
          "maxLength": 40
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "subcategory": {
          "type": "string",
          "maxLength": 100
        },
        "payee": {
          "type": "string",
          "maxLength": 120
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "startDate": {
          "type": "string",
          "maxLength": 10
        },
        "unlimited": {
          "type": "boolean"
        },
        "endDate": {
          "type": "string",
          "maxLength": 10
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "day",
        "accountId",
        "type",
        "amount",
        "paymentMethod",
        "checkNumber",
        "category",
        "subcategory",
        "payee",
        "label",
        "startDate",
        "unlimited",
        "endDate",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserSettings" },
      "description": "User settings and preferences document per authenticated user"
    },
    "/users/{userId}/accounts/{accountId}": {
      "schema": { "$ref": "#/entities/Account" },
      "description": "User bank and savings accounts"
    },
    "/users/{userId}/transactions/{txId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "User financial operations synced in real time across devices"
    },
    "/users/{userId}/categories/{catId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "User budget categories and subcategories"
    },
    "/users/{userId}/payees/{payeeId}": {
      "schema": { "$ref": "#/entities/Payee" },
      "description": "User payees and default category mappings"
    },
    "/users/{userId}/schedules/{scheduleId}": {
      "schema": { "$ref": "#/entities/Schedule" },
      "description": "User monthly recurring schedules"
    }
  }
}
