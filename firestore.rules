rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedOwner(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && request.auth.token.email_verified == true;
    }

    function hasUserDoc(userId) {
      return existsAfter(/databases/$(database)/documents/users/$(userId));
    }

    function hasAccountDoc(userId, accountId) {
      return isValidId(accountId)
        && existsAfter(/databases/$(database)/documents/users/$(userId)/accounts/$(accountId));
    }

    // 3. Entity Validation Blueprints
    function isValidUserSettings(data, userId) {
      return data.keys().hasAll(['uid', 'theme', 'selectedAccountId', 'paymentMethods', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'theme', 'selectedAccountId', 'paymentMethods', 'skippedOccurrences', 'updatedAt'])
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.uid.size() <= 128
        && data.theme is string
        && (data.theme == 'light' || data.theme == 'dark')
        && data.selectedAccountId is string
        && isValidId(data.selectedAccountId)
        && data.paymentMethods is list
        && data.paymentMethods.size() >= 1
        && data.paymentMethods.size() <= 30
        && data.paymentMethods[0] is string
        && data.paymentMethods[0].size() >= 1
        && data.paymentMethods[0].size() <= 80
        && (
          !('skippedOccurrences' in data)
          || (
            data.skippedOccurrences is list
            && data.skippedOccurrences.size() <= 100
            && (
              data.skippedOccurrences.size() == 0
              || (
                data.skippedOccurrences[0] is string
                && data.skippedOccurrences[0].size() >= 1
                && data.skippedOccurrences[0].size() <= 128
              )
            )
          )
        )
        && data.updatedAt is timestamp;
    }

    function isValidAccount(data, userId, accountId) {
      return data.keys().hasAll(['id', 'ownerId', 'name', 'initialBalance', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'name', 'initialBalance', 'createdAt', 'updatedAt'])
        && data.id is string
        && data.id == accountId
        && isValidId(data.id)
        && data.ownerId is string
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 120
        && (data.initialBalance is int || data.initialBalance is float)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTransaction(data, userId, txId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'date', 'accountId', 'type', 'amount',
          'paymentMethod', 'checkNumber', 'category', 'subcategory',
          'payee', 'label', 'cleared', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'date', 'accountId', 'type', 'amount',
          'paymentMethod', 'checkNumber', 'category', 'subcategory',
          'payee', 'label', 'cleared', 'createdAt', 'updatedAt'
        ])
        && data.id is string
        && data.id == txId
        && isValidId(data.id)
        && data.ownerId is string
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.date is string
        && data.date.size() == 10
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.accountId is string
        && isValidId(data.accountId)
        && data.type is string
        && (data.type == 'income' || data.type == 'expense')
        && (data.amount is int || data.amount is float)
        && data.amount > 0
        && data.paymentMethod is string
        && data.paymentMethod.size() >= 1
        && data.paymentMethod.size() <= 80
        && data.checkNumber is string
        && data.checkNumber.size() <= 40
        && data.category is string
        && data.category.size() >= 1
        && data.category.size() <= 100
        && data.subcategory is string
        && data.subcategory.size() <= 100
        && data.payee is string
        && data.payee.size() <= 120
        && data.label is string
        && data.label.size() >= 1
        && data.label.size() <= 200
        && data.cleared is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCategory(data, userId, catId) {
      return data.keys().hasAll(['id', 'ownerId', 'name', 'budget', 'subcategories', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'name', 'budget', 'subcategories', 'createdAt', 'updatedAt'])
        && data.id is string
        && data.id == catId
        && isValidId(data.id)
        && data.ownerId is string
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 100
        && (data.budget is int || data.budget is float)
        && data.budget >= 0
        && data.subcategories is list
        && data.subcategories.size() <= 50
        && (data.subcategories.size() == 0 || (data.subcategories[0] is string && data.subcategories[0].size() <= 100))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPayee(data, userId, payeeId) {
      return data.keys().hasAll(['id', 'ownerId', 'name', 'defaultCategory', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'name', 'defaultCategory', 'createdAt', 'updatedAt'])
        && data.id is string
        && data.id == payeeId
        && isValidId(data.id)
        && data.ownerId is string
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 120
        && data.defaultCategory is string
        && data.defaultCategory.size() <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSchedule(data, userId, scheduleId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'day', 'accountId', 'type', 'amount',
          'paymentMethod', 'checkNumber', 'category', 'subcategory',
          'payee', 'label', 'startDate', 'unlimited', 'endDate',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'day', 'accountId', 'type', 'amount',
          'paymentMethod', 'checkNumber', 'category', 'subcategory',
          'payee', 'label', 'startDate', 'unlimited', 'endDate',
          'createdAt', 'updatedAt'
        ])
        && data.id is string
        && data.id == scheduleId
        && isValidId(data.id)
        && data.ownerId is string
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.day is int
        && data.day >= 1
        && data.day <= 28
        && data.accountId is string
        && isValidId(data.accountId)
        && data.type is string
        && (data.type == 'income' || data.type == 'expense')
        && (data.amount is int || data.amount is float)
        && data.amount > 0
        && data.paymentMethod is string
        && data.paymentMethod.size() >= 1
        && data.paymentMethod.size() <= 80
        && data.checkNumber is string
        && data.checkNumber.size() <= 40
        && data.category is string
        && data.category.size() >= 1
        && data.category.size() <= 100
        && data.subcategory is string
        && data.subcategory.size() <= 100
        && data.payee is string
        && data.payee.size() <= 120
        && data.label is string
        && data.label.size() >= 1
        && data.label.size() <= 200
        && data.startDate is string
        && (data.startDate == '' || (data.startDate.size() == 10 && data.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && data.unlimited is bool
        && data.endDate is string
        && (data.endDate == '' || (data.endDate.size() == 10 && data.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 4. Collection Rules
    match /users/{userId} {
      allow get: if isVerifiedOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidUserSettings(incoming(), userId)
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidUserSettings(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['theme', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['selectedAccountId', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['paymentMethods', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['skippedOccurrences', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['theme', 'selectedAccountId', 'paymentMethods', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['theme', 'selectedAccountId', 'paymentMethods', 'skippedOccurrences', 'updatedAt'])
        );
      allow delete: if isVerifiedOwner(userId) && isValidId(userId);

      match /accounts/{accountId} {
        allow get: if isVerifiedOwner(userId) && isValidId(accountId) && hasUserDoc(userId);
        allow list: if isVerifiedOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isVerifiedOwner(userId)
          && isValidId(accountId)
          && isValidAccount(incoming(), userId, accountId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasUserDoc(userId);
        allow update: if isVerifiedOwner(userId)
          && isValidId(accountId)
          && isValidAccount(incoming(), userId, accountId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && hasUserDoc(userId)
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'initialBalance', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['initialBalance', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt'])
          );
        allow delete: if isVerifiedOwner(userId) && isValidId(accountId) && hasUserDoc(userId);
      }

      match /transactions/{txId} {
        allow get: if isVerifiedOwner(userId) && isValidId(txId) && hasUserDoc(userId);
        allow list: if isVerifiedOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isVerifiedOwner(userId)
          && isValidId(txId)
          && isValidTransaction(incoming(), userId, txId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasUserDoc(userId)
          && hasAccountDoc(userId, incoming().accountId);
        allow update: if isVerifiedOwner(userId)
          && isValidId(txId)
          && isValidTransaction(incoming(), userId, txId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && hasUserDoc(userId)
          && hasAccountDoc(userId, incoming().accountId)
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['cleared', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['category', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['payee', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'date', 'accountId', 'type', 'amount', 'paymentMethod',
              'checkNumber', 'category', 'subcategory', 'payee', 'label', 'cleared', 'updatedAt'
            ])
          );
        allow delete: if isVerifiedOwner(userId) && isValidId(txId) && hasUserDoc(userId);
      }

      match /categories/{catId} {
        allow get: if isVerifiedOwner(userId) && isValidId(catId) && hasUserDoc(userId);
        allow list: if isVerifiedOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isVerifiedOwner(userId)
          && isValidId(catId)
          && isValidCategory(incoming(), userId, catId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasUserDoc(userId);
        allow update: if isVerifiedOwner(userId)
          && isValidId(catId)
          && isValidCategory(incoming(), userId, catId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && hasUserDoc(userId)
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'budget', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['subcategories', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'budget', 'subcategories', 'updatedAt'])
          );
        allow delete: if isVerifiedOwner(userId) && isValidId(catId) && hasUserDoc(userId);
      }

      match /payees/{payeeId} {
        allow get: if isVerifiedOwner(userId) && isValidId(payeeId) && hasUserDoc(userId);
        allow list: if isVerifiedOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isVerifiedOwner(userId)
          && isValidId(payeeId)
          && isValidPayee(incoming(), userId, payeeId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasUserDoc(userId);
        allow update: if isVerifiedOwner(userId)
          && isValidId(payeeId)
          && isValidPayee(incoming(), userId, payeeId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && hasUserDoc(userId)
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'defaultCategory', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['defaultCategory', 'updatedAt'])
          );
        allow delete: if isVerifiedOwner(userId) && isValidId(payeeId) && hasUserDoc(userId);
      }

      match /schedules/{scheduleId} {
        allow get: if isVerifiedOwner(userId) && isValidId(scheduleId) && hasUserDoc(userId);
        allow list: if isVerifiedOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isVerifiedOwner(userId)
          && isValidId(scheduleId)
          && isValidSchedule(incoming(), userId, scheduleId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasUserDoc(userId)
          && hasAccountDoc(userId, incoming().accountId);
        allow update: if isVerifiedOwner(userId)
          && isValidId(scheduleId)
          && isValidSchedule(incoming(), userId, scheduleId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && hasUserDoc(userId)
          && hasAccountDoc(userId, incoming().accountId)
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['category', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['payee', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'day', 'accountId', 'type', 'amount', 'paymentMethod', 'checkNumber',
              'category', 'subcategory', 'payee', 'label', 'startDate', 'unlimited', 'endDate', 'updatedAt'
            ])
          );
        allow delete: if isVerifiedOwner(userId) && isValidId(scheduleId) && hasUserDoc(userId);
      }
    }
  }
}
